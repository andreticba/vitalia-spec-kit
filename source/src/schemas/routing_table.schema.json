          },
          "command": {
            "type": "string"
          },
          "emoji": {
            "type": "string"
          },
          "gates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "priority": {
            "type": "integer"
          },
          "fallback": {
            "type": "boolean"
          },
          "patterns": {
