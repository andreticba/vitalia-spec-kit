#!/usr/bin/env bash
# install-project | Vitalia SPEC Kit v0.0.1 | 08-11-2026 19:56(GMT-04:00)
# Ativa o Vitalia SPEC Kit num projeto hospedeiro específico.
# Referência: FR-003, PRES-02/BUG-02, PRES-03/BUG-03, RCA-04a, RCA-04b.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="${SCRIPT_DIR}/lib"
DEFAULT_KIT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
KIT_DIR="${VITALIA_KIT_DIR:-${DEFAULT_KIT_DIR}}"

SESSION_REPO=""
DATA_REPO=""
NON_INTERACTIVE=0
INSTALL_AGY="S"
INSTALL_GEMINI_CLI="n"

usage() {
    cat << 'EOF'
Uso: vitalia-install-project [OPÇÕES]

Opções:
  --session-repo <URL>  URL ou caminho do repositório Git de sessão (.vitalia/memory/session)
  --data-repo <URL>     URL ou caminho do repositório Git de dados (.vitalia/memory/data_storage)
  --non-interactive     Executa sem prompts interativos
  -h, --help            Exibe esta mensagem de ajuda
EOF
}

while [ $# -gt 0 ]; do
    case "$1" in
        --session-repo)
            SESSION_REPO="${2:-}"
            shift 2
            ;;
        --session-repo=*)
            SESSION_REPO="${1#*=}"
            shift
            ;;
        --data-repo)
            DATA_REPO="${2:-}"
            shift 2
            ;;
        --data-repo=*)
            DATA_REPO="${1#*=}"
            shift
            ;;
        --non-interactive)
            NON_INTERACTIVE=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "❌ Opção desconhecida: $1" >&2
            usage >&2
            exit 1
            ;;
    esac
done

for lib in logger.sh env_manager.sh agent_preserver.sh skill_generator.sh git_storage_manager.sh; do
    if [ -f "${LIB_DIR}/${lib}" ]; then
        # shellcheck source=/dev/null
        source "${LIB_DIR}/${lib}"
    else
        echo "❌ Biblioteca ${lib} não encontrada em ${LIB_DIR}. Execute o kit-bootstrap.sh." >&2
        exit 1
    fi
done

PROJECT_DIR="${PWD}"
VITALIA_DIR="${PROJECT_DIR}/.vitalia"
MEMORY_DIR="${VITALIA_DIR}/memory"
CONFIG_FILE="${VITALIA_DIR}/config.yml"
ENV_FILE="${PROJECT_DIR}/.env"

if [ -f "${KIT_DIR}/VERSION" ]; then
    VERSION="$(cat "${KIT_DIR}/VERSION")"
else
    VERSION="0.0.1"
fi

echo ""
echo "╔══════════════════════════════════════════════════╗"
echo "║   Vitalia SPEC Kit v${VERSION} — Ativação de Projeto    ║"
echo "╚══════════════════════════════════════════════════╝"
echo "📂 Projeto: $(basename "${PROJECT_DIR}")"
echo "📦 Kit: ${KIT_DIR} (v${VERSION})"
echo ""

# ─────────────────────────────────────────────────────────────
# PASSO 1: Criar estrutura .vitalia/
# ─────────────────────────────────────────────────────────────
log_step "1" "Estrutura .vitalia/..."
mkdir -p "${VITALIA_DIR}/memory/session"
mkdir -p "${VITALIA_DIR}/memory/data_storage"
mkdir -p "${VITALIA_DIR}/backups"

if [ ! -f "${VITALIA_DIR}/feature.json" ]; then
    echo '{"feature_directory": ""}' > "${VITALIA_DIR}/feature.json"
fi

if [ ! -f "${VITALIA_DIR}/extensions.yml" ]; then
    cat > "${VITALIA_DIR}/extensions.yml" << 'YAML'
# .vitalia/extensions.yml — Hooks do projeto
hooks:
  before_specify: []
  after_specify: []
  before_plan: []
  after_plan: []
  after_tasks:
    - extension: analyze
      command: vitalia-analyze
      optional: false
  before_implement: []
  after_implement: []
YAML
fi

log_ok ".vitalia/ inicializado com sucesso"

# ─────────────────────────────────────────────────────────────
# PASSO 2: Repositórios de memória (Session & Data Storage)
# ─────────────────────────────────────────────────────────────
log_step "2" "Repositórios de memória..."

if [ "${NON_INTERACTIVE}" -eq 0 ] && [ -t 0 ]; then
    if [ -z "${SESSION_REPO}" ]; then
        read -r -p "   URL do repositório Git de SESSÃO (Enter para local): " SESSION_REPO || true
    fi
    if [ -z "${DATA_REPO}" ]; then
        read -r -p "   URL do repositório Git de DADOS (Enter para local): " DATA_REPO || true
    fi
fi

setup_session_repo "${MEMORY_DIR}" "${SESSION_REPO}"
setup_data_repo "${MEMORY_DIR}" "${DATA_REPO}"

# ─────────────────────────────────────────────────────────────
# PASSO 3: Configuração de Ambiente (.env) sem Redis
# ─────────────────────────────────────────────────────────────
log_step "3" "Configuração de Ambiente (.env)..."
manage_kit_env "${ENV_FILE}" "${KIT_DIR}" "${SESSION_REPO}" "${DATA_REPO}"

# ─────────────────────────────────────────────────────────────
# PASSO 4: Selecionar integrações
# ─────────────────────────────────────────────────────────────
log_step "4" "Integrações..."
if [ "${NON_INTERACTIVE}" -eq 0 ] && [ -t 0 ]; then
    read -r -p "   [ ] Antigravity IDE (.agents/skills/)? [S/n]: " choice_agy || true
    INSTALL_AGY="${choice_agy:-S}"

    read -r -p "   [ ] Gemini CLI (.gemini/commands/)? [s/N]: " choice_gemini || true
    INSTALL_GEMINI_CLI="${choice_gemini:-n}"
fi

# ─────────────────────────────────────────────────────────────
# PASSO 5: Gerar skills com pureza 100% e sincronizar AGENTS.md
# ─────────────────────────────────────────────────────────────
log_step "5" "Gerando skills e integrando agentes..."

TEMPLATE="${KIT_DIR}/integrations/antigravity/SKILL.md.template"
AGENTS_SKILLS_DIR="${PROJECT_DIR}/.agents/skills"

if [[ "${INSTALL_AGY}" =~ ^[Ss]$ ]]; then
    sanitize_and_generate_skills \
        "${KIT_DIR}/extensions" \
        "${AGENTS_SKILLS_DIR}" \
        "${TEMPLATE}" \
        "${VERSION}" \
        "${KIT_DIR}" \
        "${VITALIA_DIR}"

    if [ -f "${KIT_DIR}/AGENTS.md" ]; then
        kit_agents_content="$(sed \
            -e "s|{{VERSION}}|${VERSION}|g" \
            -e "s|{{VITALIA_KIT_DIR}}|${KIT_DIR}|g" \
            "${KIT_DIR}/AGENTS.md")"
        update_agents_md "${PROJECT_DIR}/.agents/AGENTS.md" "${kit_agents_content}" "${VITALIA_DIR}/backups"
    fi

    log_ok "Antigravity IDE: 16 skills ativas configuradas com pureza total em .agents/skills/"
fi

GEMINI_DIR="${PROJECT_DIR}/.gemini/commands"
if [[ "${INSTALL_GEMINI_CLI}" =~ ^[Ss]$ ]]; then
    mkdir -p "${GEMINI_DIR}"
    if [ -d "${KIT_DIR}/extensions" ]; then
        for toml_file in "${KIT_DIR}/extensions/"*.toml; do
            [ -f "${toml_file}" ] || continue
            ext_name="$(basename "${toml_file}" .toml)"
            cmd_file="${GEMINI_DIR}/vitalia.${ext_name}.toml"
            sed \
                -e "s|{{VERSION}}|${VERSION}|g" \
                -e "s|{{VITALIA_KIT_DIR}}|${KIT_DIR}|g" \
                "${toml_file}" > "${cmd_file}"
            log_ok "vitalia.${ext_name}.toml gerado"
        done
    fi
fi

# ─────────────────────────────────────────────────────────────
# PASSO 6: Criar config.yml e atualizar .gitignore
# ─────────────────────────────────────────────────────────────
log_step "6" "Finalizando configuração do projeto..."

cat > "${CONFIG_FILE}" << YAML
# .vitalia/config.yml | Vitalia SPEC Kit v${VERSION} | $(date -u -d '-4 hours' '+%d-%m-%Y %H:%M(GMT-04:00)' 2>/dev/null || date '+%d-%m-%Y %H:%M(GMT-04:00)')
# NÃO commitar este arquivo — protegido via .gitignore

kit_version: "${VERSION}"
project: "$(basename "${PROJECT_DIR}")"
kit_dir: "${KIT_DIR}"

memory:
  session_repo: "${SESSION_REPO}"
  data_repo: "${DATA_REPO}"

integrations:
  antigravity: $([[ "${INSTALL_AGY}" =~ ^[Ss]$ ]] && echo "true" || echo "false")
  gemini_cli: $([[ "${INSTALL_GEMINI_CLI}" =~ ^[Ss]$ ]] && echo "true" || echo "false")
YAML

touch "${PROJECT_DIR}/.gitignore"
for pattern in ".env" ".vitalia/config.yml" ".vitalia/memory/" ".vitalia/backups/" ".vitalia/.vitalia-manifest"; do
    if ! grep -qF "${pattern}" "${PROJECT_DIR}/.gitignore" 2>/dev/null; then
        echo "${pattern}" >> "${PROJECT_DIR}/.gitignore"
    fi
done

echo ""
echo "╔══════════════════════════════════════════════════╗"
echo "║              ✅ Ativação concluída               ║"
echo "╚══════════════════════════════════════════════════╝"
echo "   Kit: ${KIT_DIR} (v${VERSION})"
[ -n "${SESSION_REPO}" ] && echo "   Sessão: ${SESSION_REPO}"
[ -n "${DATA_REPO}" ]    && echo "   Dados: ${DATA_REPO}"
[[ "${INSTALL_AGY}" =~ ^[Ss]$ ]] && echo "   AGY: 16 skills em .agents/skills/"
echo ""
echo "   Próximo passo: /vitalia-session-start"
echo ""
